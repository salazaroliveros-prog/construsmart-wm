# Ejemplo de variables de entorno
# Copia este archivo a `.env` (desarrollo local) y completa los valores reales.
# NUNCA subas los valores reales al repositorio: solo este archivo de ejemplo.
#
# En produccion (Vercel) configura estas mismas variables en el dashboard,
# jamas hardcodees claves en el codigo o en scripts.
#
# ---------------------------------------------------------------------------
# SUPABASE
# ---------------------------------------------------------------------------
# URL del proyecto Supabase (sin secretos; es un identificador publico).
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co

# Claves de cliente. NO son secretas (viajan al navegador), pero igual debes
# usar variables de entorno, nunca valores fijos en el codigo.
# El cliente del navegador usa NEXT_PUBLIC_SUPABASE_ANON_KEY o SUPABASE_PUBLISHABLE_KEY.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Alias usados por scripts de verificacion/seed (scripts/*.js/ts).
# SUPABASE_PUBLISHABLE_KEY es el alias de la clave publicable,
# SUPABASE_ANON_KEY el de la clave anonima.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key-here

# Clave de servicio (SECRETA). Solo para operaciones de admin en el servidor
# (lib/supabase/admin.ts) y scripts de seed (SUPABASE_SECRET_KEY). NUNCA la
# expongas al navegador ni tampoco la pongas como NEXT_PUBLIC_*.
SUPABASE_SECRET_KEY=your-service-role-key-here
# Alias alternativo usado por algunos scripts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ---------------------------------------------------------------------------
# APP
# ---------------------------------------------------------------------------
# URLs de la aplicacion. Usadas por next.config.ts y lib/config/app.config.ts.
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# ADMIN / SEGURIDAD
# ---------------------------------------------------------------------------
# Email autorizado para rutas administrativas (app/api/...). Define el email
# real en tu .env local y en Vercel.
ADMIN_EMAIL=admin@example.com

# ---------------------------------------------------------------------------
# OPCIONALES / RUNTIME
# ---------------------------------------------------------------------------
# Solo desarrollo/produccion local; no son secretos.
# PORT=3000
# NODE_MEMORY_LIMIT_MB=4096
# DATABASE_URL=postgresql://... (solo para scripts que se conectan directo)
# SUPABASE_DB_PASSWORD=... (solo si usas connexion directa a la base)